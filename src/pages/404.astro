---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page not found · AroraMSP"
  description="The page you are looking for does not exist."
  page=""
  canonical="https://aroramsp.com/404"
  ogTitle="Page not found · AroraMSP"
  ogDescription="The page you are looking for does not exist."
>
  <section class="page wrap">
    <div class="not-found">
      <div class="not-found-code">404</div>
      <h1>This page does not exist.</h1>
      <p>The link you followed may be outdated or the page may have moved. Here are some useful places to start:</p>
      <div class="not-found-links">
        <a href="/" class="btn btn-primary">Go to homepage →</a>
        <a href="/services" class="btn btn-ghost">View services →</a>
        <a href="/blog" class="btn btn-ghost">Read the blog →</a>
        <a href="/contact" class="btn btn-ghost">Get in touch →</a>
      </div>
    </div>
  </section>
</Layout>
